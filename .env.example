# Azure OpenAI Realtime — GA endpoint, no api-version anywhere.
# Copy this file to .env and fill in real values. Never commit .env.

# e.g. https://your-resource-name.openai.azure.com  (no trailing slash, no path)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com

# Azure resource API key (Keys and Endpoint blade in the Foundry/Azure portal).
# Server-side only — this must never reach the RN app bundle or device.
AZURE_OPENAI_API_KEY=<your-api-key>

# The realtime deployment name, e.g. gpt-realtime-2.1-feg
# This is what goes in the request body as session.model — there is no
# ?deployment= or ?model= query param on the GA endpoints.
AZURE_OPENAI_REALTIME_DEPLOYMENT=<your-deployment-name>
